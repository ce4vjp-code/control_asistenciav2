# Proteger archivos sensibles de configuración, logs y repositorios
<FilesMatch "\.(env|json|log|git)$|^(config\.php|session_config\.php)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Cabeceras de seguridad HTTP básicas
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
