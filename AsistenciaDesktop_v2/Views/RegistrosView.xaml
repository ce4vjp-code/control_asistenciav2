<UserControl x:Class="AsistenciaDesktop_v2.Views.RegistrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,20" Padding="20" UniformCornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Reportes de Asistencia" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    
                                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <TextBlock Text="Fecha:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                        <DatePicker x:Name="dpFecha" Width="150" SelectedDateChanged="DpFecha_SelectedDateChanged"
                                    VerticalAlignment="Center" FontSize="16"/>
                                    
                        <TextBlock Text="Curso:" VerticalAlignment="Center" Margin="20,0,10,0" FontSize="16"/>
                        <ComboBox x:Name="cmbCurso" Width="150" SelectionChanged="CmbCurso_SelectionChanged"
                                  VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="btnBorrarTodo" Content="BORRAR TODO" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="Red" BorderBrush="Red" Margin="0,0,10,0" Click="BtnBorrarTodo_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnReporteInasistencia" Content="INASISTENCIAS" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Click="BtnReporteInasistencia_Click"/>
                    <Button x:Name="btnReporteEspecial" Content="SALIDA SIN COMEDOR" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Click="BtnReporteEspecial_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnExportar" Content="GUARDAR PDF" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Click="BtnExportar_Click"/>
                    <Button x:Name="btnEnviar" Content="ENVIAR A ADMINS" Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnEnviar_Click"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Tabla -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8">
            <DataGrid x:Name="GridRegistros" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8" materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="RUT" Binding="{Binding Rut}" Width="120" />
                    <DataGridTextColumn Header="Nombre Alumno" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="Curso" Binding="{Binding Curso}" Width="100" />
                    <DataGridTextColumn Header="Ingreso Colegio" Binding="{Binding HoraIngreso}" Width="130" />
                    <DataGridTextColumn Header="Comedor" Binding="{Binding HoraComedor}" Width="130" />
                    <DataGridTextColumn Header="Salida Colegio" Binding="{Binding HoraSalida}" Width="130" />
                    <DataGridTemplateColumn Header="Acciones">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding BotonBorrarVisibilidad}">
                                    <Button Content="X ING" CommandParameter="{Binding Rut}" Click="BtnEliminarIngreso_Click"
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Padding="5" Margin="0,0,2,0" ToolTip="Borrar Ingreso"/>
                                    <Button Content="X COM" CommandParameter="{Binding Rut}" Click="BtnEliminarComedor_Click"
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Padding="5" Margin="0,0,2,0" ToolTip="Borrar Comedor"/>
                                    <Button Content="X SAL" CommandParameter="{Binding Rut}" Click="BtnEliminarSalida_Click"
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Padding="5" ToolTip="Borrar Salida"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>



