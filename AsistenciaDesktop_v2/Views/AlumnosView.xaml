<UserControl x:Class="AsistenciaDesktop_v2.Views.AlumnosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera y Botones -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,20" Padding="20" UniformCornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Gestión de Alumnos" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBox x:Name="txtBuscar" Width="300" Margin="0,10,0,0" HorizontalAlignment="Left"
                             materialDesign:HintAssist.Hint="Buscar por nombre o RUT..."
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             TextChanged="txtBuscar_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="IMPORTAR CSV" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Click="BtnImportarCSV_Click"/>
                    <Button Content="NUEVO ALUMNO" Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnNuevo_Click"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Tabla -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8">
            <DataGrid x:Name="GridAlumnos" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8" materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="RUT" Binding="{Binding NumeroUnico}" Width="150" />
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="Curso" Binding="{Binding Curso}" Width="100" />
                    <DataGridTextColumn Header="Email Apoderado" Binding="{Binding EmailApoderado}" Width="250" />
                    
                    <DataGridTemplateColumn Header="Acciones">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="EDITAR" CommandParameter="{Binding}" Click="BtnEditar_Click"
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Blue" Padding="5" Margin="0,0,5,0"/>
                                    <Button Content="ELIMINAR" CommandParameter="{Binding NumeroUnico}" Click="BtnEliminar_Click"
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Padding="5"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
