<UserControl x:Class="AsistenciaDesktop_v2.Views.ScannerComedorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,15" Padding="20" UniformCornerRadius="8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Control de Raciones - Comedor" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                        <TextBlock Text="Escanee el RUT del alumno para entregar colación." FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <TextBox Grid.Column="1" x:Name="txtScanComedor" Width="300" FontSize="20"
                             materialDesign:HintAssist.Hint="Escáner (RUT)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             KeyDown="txtScanComedor_KeyDown" />
                </Grid>

                <!-- Feedback Mini -->
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <materialDesign:PackIcon x:Name="IconoEstado" Kind="FoodApple" Width="24" Height="24" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtNombreUltimo" Text="Esperando lectura..." FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtCursoUltimo" Text="-" FontSize="16" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtMensajeUltimo" Text="" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Estadísticas Horizontales -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,15" Padding="15" UniformCornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Raciones de Hoy:" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                
                <Border Background="#E0F2F1" CornerRadius="8" Padding="15,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Entregadas: " Foreground="#00695C" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalComedor" Text="0" Foreground="#00695C" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </materialDesign:Card>

        <!-- Búsqueda y Lista (Full Width) -->
        <materialDesign:Card Grid.Row="2" Padding="20" UniformCornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBox Grid.Row="0" x:Name="txtBuscar" Margin="0,0,0,10"
                         materialDesign:HintAssist.Hint="Buscar alumno por RUT, Nombre o Curso..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         TextChanged="txtBuscar_TextChanged"/>
                         
                <DataGrid Grid.Row="1" x:Name="dgAlumnos" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          Background="White" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RUT" Binding="{Binding NumeroUnico}" Width="*"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*"/>
                        <DataGridTextColumn Header="Curso" Binding="{Binding Curso}" Width="*"/>
                        <DataGridTemplateColumn Header="Acción" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Entregar" CommandParameter="{Binding NumeroUnico}" Click="btnMarcarManual_Click" 
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>

