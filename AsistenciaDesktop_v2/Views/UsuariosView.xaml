<UserControl x:Class="AsistenciaDesktop_v2.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid>
                <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,20" Padding="20" UniformCornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Gestión de Usuarios" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="Administre los accesos al sistema y correos para reportes" FontSize="14" Foreground="Gray"/>
                </StackPanel>

                <Button Grid.Column="1" Content="NUEVO USUARIO" Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Center" Click="BtnNuevo_Click"/>
            </Grid>
        </materialDesign:Card>

        <!-- Tabla -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8">
            <DataGrid x:Name="GridUsuarios" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8" materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="150" />
                    <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="100" />
                    <DataGridTextColumn Header="Correo (Reportes)" Binding="{Binding Email}" Width="*" />
                    
                    <DataGridTemplateColumn Header="Acciones">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="EDITAR" CommandParameter="{Binding}" Click="BtnEditar_Click"
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Blue" Padding="5" Margin="0,0,5,0"/>
                                    <Button Content="ELIMINAR" CommandParameter="{Binding Username}" Click="BtnEliminar_Click"
                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Padding="5"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
                </materialDesign:Card>

        <!-- Configuración de Tareas (Solo Cirdam) -->
        <materialDesign:Card x:Name="CardConfiguracion" Grid.Row="2" Margin="0,20,0,0" Padding="20" UniformCornerRadius="8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Configuración del Sistema" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ClockOutline" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Gray"/>
                    <TextBlock Text="Generar y mostrar Reporte de Comedor a las:" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                    <materialDesign:TimePicker x:Name="tpReporteComedor" Width="100" Is24Hours="True" VerticalAlignment="Center" FontSize="16" Margin="0,0,20,0"/>
                    <Button Content="GUARDAR CONFIGURACIÓN" Click="BtnGuardarHora_Click" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>

